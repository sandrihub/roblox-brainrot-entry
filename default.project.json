{
  "name": "neon-nonsense",
  "tree": {
    "$className": "DataModel",
    "Players": {
      "$properties": {
        "CharacterAutoLoads": true
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
